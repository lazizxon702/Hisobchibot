# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
SUPER_ADMIN_TELEGRAM_ID=123456789

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://hisobchi:hisobchi_secret@localhost:5432/hisobchi_db?schema=public

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Application Settings
PORT=3000
APP_TIMEZONE=Asia/Tashkent
LOG_LEVEL=info
NODE_ENV=development

# Storage Configuration (S3 / MinIO or Local fallback)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./uploads
S3_ENDPOINT=localhost
S3_PORT=9000
S3_BUCKET=hisobchi-private
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_SSL=false

# Optional Webhook Configuration (if empty, uses Long Polling)
WEBHOOK_URL=
WEBHOOK_SECRET=
