datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleName {
  SUPER_ADMIN
  SELLER
  DAFTAR_REVIEWER
  CONTINUATION_OPERATOR
}

enum OrderStatus {
  DRAFT
  AWAITING_DAFTAR
  NEEDS_CORRECTION
  READY_FOR_HANDOFF
  ASSIGNED
  IN_PROGRESS
  FIRST_STAGE_COMPLETED
  COMPLETED
  CANCELLED
}

enum DaftarStatus {
  PENDING
  APPROVED
  NEEDS_CORRECTION
  NOT_REQUIRED
}

enum InventoryUnitStatus {
  IN_STOCK
  SOLD
  IN_TRANSIT
  EXPECTED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum Currency {
  UZS
  USD
}

enum TransactionStatus {
  CONFIRMED
  REVERSED
}

enum PaymentStatus {
  PAID
  PARTIAL
  DEBT
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum AttachmentType {
  CONTRACT_SCREENSHOT
  PASSPORT_PHOTO
  PAYMENT_PROOF
  VIDEO_NOTE
}

enum ReminderType {
  ONE_DAY_BEFORE
  DUE_DATE
  OVERDUE
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model User {
  id           String     @id @default(uuid())
  telegramId   BigInt     @unique
  username     String?
  firstName    String?
  lastName     String?
  phone        String?
  isActive     Boolean    @default(true)
  isApproved   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles        UserRole[]
  drafts       OrderDraft[]
  ordersSold   Order[]           @relation("OrderSeller")
  assignments  OrderAssignment[] @relation("AssignedOperator")
  assignedByMe OrderAssignment[] @relation("AssignmentCreatedBy")
  daftarReviews DaftarReview[]   @relation("DaftarReviewer")
  salesHandled Sale[]            @relation("SaleOperator")
  paymentsCreated Payment[]      @relation("PaymentCreator")
  reversalsCreated PaymentReversal[] @relation("ReversalCreator")
  auditEvents  AuditEvent[]      @relation("AuditUser")
  attachments  Attachment[]      @relation("AttachmentCreator")

  @@index([telegramId])
  @@index([isActive, isApproved])
}

model Role {
  id    String     @id @default(uuid())
  name  RoleName   @unique
  users UserRole[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Agency {
  id        String           @id @default(uuid())
  name      String           @unique
  ownerName String
  phone     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  employees AgencyEmployee[]
  sales     Sale[]

  @@index([name])
}

model AgencyEmployee {
  id        String   @id @default(uuid())
  agencyId  String
  fullName  String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  sales  Sale[]

  @@index([agencyId])
}

model Store {
  id        String   @id @default(uuid())
  name      String   @unique
  address   String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([name])
}

model FinancingProgram {
  id                   String   @id @default(uuid())
  name                 String   @unique
  code                 String?
  requiresContinuation Boolean  @default(true)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  orders Order[]

  @@index([name])
  @@index([requiresContinuation])
}

model Customer {
  id                String   @id @default(uuid())
  fullName          String
  phone1            String
  phone2            String?
  generalLimit      Decimal  @db.Decimal(18, 2)
  withdrawableLimit Decimal  @db.Decimal(18, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  orders Order[]

  @@index([phone1])
  @@index([fullName])
}

model Buyer {
  id         String   @id @default(uuid())
  fullName   String
  phone      String
  address    String?
  shopNumber String?
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sales Sale[]

  @@index([phone])
  @@index([fullName])
}

model Order {
  id                 String       @id @default(uuid())
  orderNumber        String       @unique
  version            Int          @default(1)
  status             OrderStatus  @default(DRAFT)
  sellerId           String
  programId          String
  storeId            String
  customerId         String
  contractEndDate    DateTime
  daftarRejected     Boolean      @default(false)
  agentPercentage    Decimal      @db.Decimal(5, 2)
  clientPayoutAmount Decimal      @db.Decimal(18, 2)
  totalPrice         Decimal      @db.Decimal(18, 2)
  totalQuantity      Int          @default(0)
  businessDate       DateTime
  cancelledReason    String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  seller          User              @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  program         FinancingProgram  @relation(fields: [programId], references: [id], onDelete: Restrict)
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  inventoryUnits  InventoryUnit[]
  assignments     OrderAssignment[]
  daftarReviews   DaftarReview[]
  sales           Sale[]
  attachments     Attachment[]

  @@index([orderNumber])
  @@index([sellerId])
  @@index([status])
  @@index([businessDate])
}

model OrderDraft {
  id        String   @id @default(uuid())
  userId    String   @unique
  step      String
  formData  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  category        String
  brand           String
  model           String
  characteristics String?
  quantity        Int
  unitPrice       Decimal  @db.Decimal(18, 2)
  totalPrice      Decimal  @db.Decimal(18, 2)
  createdAt       DateTime @default(now())

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventoryUnits InventoryUnit[]

  @@index([orderId])
}

model InventoryUnit {
  id           String              @id @default(uuid())
  orderId      String
  orderItemId  String
  category     String
  imei1        String?
  imei2        String?
  barcode      String?
  serialNumber String?
  status       InventoryUnitStatus @default(IN_STOCK)
  soldAt       DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  saleItem  SaleItem?

  @@index([orderId])
  @@index([imei1])
  @@index([barcode])
  @@index([serialNumber])
  @@index([status])
}

model OrderAssignment {
  id          String           @id @default(uuid())
  orderId     String
  operatorId  String
  assignedBy  String
  status      AssignmentStatus @default(PENDING)
  assignedAt  DateTime         @default(now())
  acceptedAt  DateTime?

  order    Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  operator User  @relation("AssignedOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  assigner User  @relation("AssignmentCreatedBy", fields: [assignedBy], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([operatorId])
  @@index([status])
}

model DaftarReview {
  id         String       @id @default(uuid())
  orderId    String
  reviewerId String?
  status     DaftarStatus @default(PENDING)
  comment    String?
  reviewedAt DateTime?
  createdAt  DateTime     @default(now())

  order    Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reviewer User? @relation("DaftarReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status])
}

model Sale {
  id                   String        @id @default(uuid())
  orderId              String
  version              Int           @default(1)
  buyerId              String
  operatorId           String
  agencyId             String?
  agencyEmployeeId     String?
  plannedSalePrice     Decimal       @db.Decimal(18, 2)
  actualSalePrice      Decimal       @db.Decimal(18, 2)
  paidAmount           Decimal       @default(0) @db.Decimal(18, 2)
  remainingAmount      Decimal       @db.Decimal(18, 2)
  paymentStatus        PaymentStatus @default(DEBT)
  hasDebt              Boolean       @default(false)
  debtDueDate          DateTime?
  videoVerifiedBy      String?
  videoVerifiedAt      DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  buyer          Buyer           @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  operator       User            @relation("SaleOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  agency         Agency?         @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  agencyEmployee AgencyEmployee? @relation(fields: [agencyEmployeeId], references: [id], onDelete: Restrict)
  items          SaleItem[]
  payments       Payment[]
  debtSchedules  DebtSchedule[]
  reminders      Reminder[]
  attachments    Attachment[]

  @@index([orderId])
  @@index([buyerId])
  @@index([operatorId])
  @@index([paymentStatus])
  @@index([hasDebt, debtDueDate])
}

model SaleItem {
  id              String   @id @default(uuid())
  saleId          String
  inventoryUnitId String   @unique
  quantity        Int      @default(1)
  unitPrice       Decimal  @db.Decimal(18, 2)
  createdAt       DateTime @default(now())

  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  inventoryUnit InventoryUnit @relation(fields: [inventoryUnitId], references: [id], onDelete: Restrict)

  @@index([saleId])
}

model Payment {
  id               String            @id @default(uuid())
  receiptNumber    String            @unique
  saleId           String
  method           PaymentMethod
  currency         Currency
  originalAmount   Decimal           @db.Decimal(18, 2)
  exchangeRate     Decimal?          @db.Decimal(12, 4)
  calculatedAmount Decimal           @db.Decimal(18, 2)
  status           TransactionStatus @default(CONFIRMED)
  createdById      String
  createdAt        DateTime          @default(now())

  sale        Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  createdBy   User             @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reversal    PaymentReversal?
  attachments Attachment[]

  @@index([receiptNumber])
  @@index([saleId])
  @@index([status])
  @@index([createdAt])
}

model PaymentReversal {
  id           String   @id @default(uuid())
  paymentId    String   @unique
  reversedById String
  reason       String
  reversedAt   DateTime @default(now())

  payment    Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reversedBy User    @relation("ReversalCreator", fields: [reversedById], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([reversedById])
}

model DebtSchedule {
  id               String    @id @default(uuid())
  saleId           String
  originalDueDate  DateTime
  currentDueDate   DateTime
  isSettled        Boolean   @default(false)
  settledAt        DateTime?
  rescheduleReason String?
  rescheduledById  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([currentDueDate])
  @@index([isSettled])
}

model Reminder {
  id           String       @id @default(uuid())
  saleId       String
  type         ReminderType
  scheduledFor DateTime
  sentAt       DateTime?
  isCancelled  Boolean      @default(false)
  createdAt    DateTime     @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([scheduledFor, isCancelled, sentAt])
}

model Attachment {
  id          String         @id @default(uuid())
  type        AttachmentType
  storagePath String
  fileName    String
  mimeType    String
  fileSize    Int
  orderId     String?
  saleId      String?
  paymentId   String?
  createdById String
  createdAt   DateTime       @default(now())

  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sale      Sale?    @relation(fields: [saleId], references: [id], onDelete: Restrict)
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  createdBy User     @relation("AttachmentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([saleId])
  @@index([type])
}

model AuditEvent {
  id            String   @id @default(uuid())
  entityName    String
  entityId      String
  action        String
  performedById String?
  oldValue      Json?
  newValue      Json?
  reason        String?
  timestamp     DateTime @default(now())

  performedBy User? @relation("AuditUser", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([entityName, entityId])
  @@index([performedById])
  @@index([timestamp])
}

model OutboxEvent {
  id          String       @id @default(uuid())
  topic       String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  createdAt   DateTime     @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
}

model ProcessedTelegramUpdate {
  id          String   @id @default(uuid())
  updateId    BigInt   @unique
  processedAt DateTime @default(now())

  @@index([updateId])
}

model SystemSetting {
  key         String  @id
  value       String
  description String?
}

model IdSequence {
  name         String @id
  currentValue BigInt @default(0)
}
